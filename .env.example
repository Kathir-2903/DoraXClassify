# Dora X Classify — copy to .env (never commit .env). docker compose and the
# backend both read it. Every value below is server-side only; the React app
# never receives these secrets. With no .env everything runs in mock mode.

# --- Application ---------------------------------------------------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# extra comma-separated origins
CORS_ORIGINS=
DEFAULT_TIMEZONE=Asia/Kolkata
# seed demo users/leads/meetings when the DB is empty
SEED_DEMO_DATA=true

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRE_MINUTES=720
# Created on first start if there are no users and SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- MongoDB -----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=dora_x_classify

# --- Classify (final docs: POST /createMS + SendAttendanceDetails) ---------
# true = realistic mock responses, no network calls
CLASSIFY_MOCK_MODE=true
CLASSIFY_API_URL=https://apiclassify.zenclass.in
CLASSIFY_CREATE_MEETING_PATH=/createMS
CLASSIFY_ATTENDANCE_PATH=/send-attendance-details
# the API key is "checked against a request header"; this is the header name
CLASSIFY_API_KEY_HEADER=Authorization-Key
CLASSIFY_API_KEY=
# request body authToken. If Classify hands you a raw hex token with no
# "auth:" prefix, paste it as-is — the backend adds the prefix automatically
# (both createMS docs show request examples with it: "auth:2a85b3a9aa...").
CLASSIFY_AUTH_TOKEN=
# request body org_id
CLASSIFY_ORG_ID=
# guvi | hackerkid
CLASSIFY_PRODUCT=guvi
# classify | zen
CLASSIFY_CREATED_BY=classify
CLASSIFY_MEETING_TYPE=scheduled
# sent as `autoRecordingStart` (Classify's own default is off; recordings feed the AI pipeline)
CLASSIFY_RECORDING_AUTOSTART=on
CLASSIFY_IS_END_TIME_GIVEN=on
# "student" is in the docs' example *response* but not their accepted *request*
# values, and is rejected live ("Invalid StudentHMSRole"); allow-video-audio is
# documented and confirmed working for a scheduled meeting + batch_data.
CLASSIFY_STUDENT_HMS_ROLE=allow-video-audio
CLASSIFY_ENABLE_CHAT=on
# Leads have no Classify account, so meetings let them join via
# guestConfig.IsGuestParticipantAllowed instead of logging in. This requires
# meetingType "open" + empty batch_data (handled automatically) — a
# "scheduled" meeting with batch_data rejects guestConfig outright ("Guest
# access cannot be enabled for a private meeting").
CLASSIFY_GUEST_MODE_ENABLED=true
CLASSIFY_GUEST_COLLECT_EMAIL=true
CLASSIFY_GUEST_COLLECT_PHONE=false
CLASSIFY_TIMEZONE=Asia/Kolkata
# A real createMS call has been observed to take longer than 20s; kept under
# the frontend's 60s request timeout for the schedule action.
CLASSIFY_TIMEOUT_SECONDS=45
CLASSIFY_THUMBNAIL=Default
CLASSIFY_DEFAULT_MIN_DURATION=1
CLASSIFY_DEFAULT_DURATION_MINUTES=30
CLASSIFY_EMAIL_SUBJECT=Your Dora X Classify Sales Meeting
CLASSIFY_EMAIL_MESSAGE=Please join the scheduled meeting using the meeting link.
CLASSIFY_EMAIL_FOOTER=Dora X Classify
# The meeting join link: Classify's own meeting dashboard, keyed by the
# createMS `uniqueId` as the `session` query param. One link serves both the
# host and the lead — Classify resolves the role from the signed-in session.
CLASSIFY_MEETING_LINK_BASE=https://classify.zenclass.in/meet-dashboard-new
CLASSIFY_MEETING_LINK_PARAM=session
# Optional override (e.g. a white-label domain) instead of the link above.
# Placeholders: {unique_id} {student_code} {host_code} {room_id}.
CLASSIFY_STUDENT_JOIN_URL_TEMPLATE=
CLASSIFY_HOST_JOIN_URL_TEMPLATE=
# SendAttendanceDetails documents Attendedtime in minutes
CLASSIFY_ATTENDANCE_TIME_UNIT=minutes
# SendAttendanceDetails: creator_email must belong to a Classify ADMIN account (required in real mode)
CLASSIFY_CREATOR_EMAIL=
CLASSIFY_ATTENDANCE_FOR=meet
# first attendance pull N minutes after the scheduled end; retried while Classify says "Class in progress"
CLASSIFY_ATTENDANCE_SYNC_DELAY_MINUTES=5
CLASSIFY_ATTENDANCE_RETRY_MINUTES=10
CLASSIFY_ATTENDANCE_MAX_ATTEMPTS=12

# --- Webhook (optional push; attendance is also pulled automatically) --------
# Classify must send it as the `api-key` header (documented pattern) or sign
# the raw body: X-Classify-Signature: sha256=<hex hmac>. Required in production.
WEBHOOK_SECRET=

# --- Gemini ------------------------------------------------------------------
# Analysis (objections, pitch coverage, follow-up) calls the real Gemini API
# whenever GEMINI_API_KEY is set. Transcription is separate — see
# TRANSCRIPTION_PROVIDER below — so this no longer controls it.
GEMINI_MOCK_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# defaults to GEMINI_MODEL
GEMINI_TRANSCRIPTION_MODEL=

# --- Transcription -------------------------------------------------------------
# "whisper" runs a local faster-whisper model over the downloaded recording —
# free, real, no API key, no per-call cost. "gemini" uploads the recording to
# Gemini's Files API instead (respects GEMINI_MOCK_MODE for cost control).
# Meetings with no real recording (fully-mock Classify data) always fall back
# to a scripted example transcript, clearly flagged as such in the UI.
TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Email -------------------------------------------------------------------
EMAIL_MOCK_MODE=true
# smtp | sendgrid
EMAIL_PROVIDER=smtp
# SendGrid API key
EMAIL_API_KEY=
EMAIL_FROM=Dora X Classify <no-reply@yourcompany.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Recordings (S3) ---------------------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_BUCKET=
RECORDING_STORAGE_DIR=./storage/recordings

# --- Workers -------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60
NO_SHOW_GRACE_MINUTES=30

# --- Docker (docker compose only) ------------------------------------------------
# host ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
MONGO_PORT=27017
# set true if code changes are not picked up inside containers
WATCHFILES_FORCE_POLLING=false
VITE_USE_POLLING=false
